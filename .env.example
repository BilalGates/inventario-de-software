# ---------------------------------------------------------------------------
# Plantilla de configuración — Inventario Asserta
# ---------------------------------------------------------------------------
# 1. Copia este fichero a `.env`  (copy .env.example .env)
# 2. Rellena los valores con tu configuración local de MySQL.
# 3. NUNCA subas tu `.env` al repositorio (está ignorado en .gitignore).
# ---------------------------------------------------------------------------

# Conexión MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=inventario_software

# Usuario de aplicación con permisos mínimos (SELECT/INSERT/UPDATE/DELETE).
# NO uses 'root' fuera de pruebas desechables. Crea 'inventario_app' siguiendo
# las instrucciones de docs/OPERACION.md.
DB_USER=inventario_app
DB_PASSWORD=cambia_esta_contrasena

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# Por seguridad, la app se NIEGA a arrancar si detecta una conexión insegura
# (usuario 'root' o contraseña vacía). Esto evita arrancar accidentalmente
# contra una instancia sin endurecer.
#
# Solo para desarrollo local desechable puedes saltarte esa comprobación
# poniendo la siguiente variable a "true". Déjala vacía o en "false" en
# cualquier entorno real.
ALLOW_INSECURE_LOCAL_DB=false
