# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.dll
.pytest_cache/
.ruff_cache/
.coverage
.cache
*.egg-info/
.eggs/

# Entornos virtuales
venv/
env/
ENV/
.venv/

# Variables de entorno (NO commitear credenciales)
# Se ignoran todos los .env reales; SOLO se versiona la plantilla .env.example
.env
.env.*
!.env.example
!.env.sample

# Build y distribución (NUNCA commitear binarios compilados)
build/
dist/
dist_fixed/
*.spec
*.exe
__pyinstaller*/

# IDEs
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Base de datos local
*.db
*.sqlite
*.sqlite3

# Backups / dumps SQL reales (NO commitear datos de inventario)
# OJO: database/*.sql y migrations/*.sql SÍ se versionan (son schema/DDL, no datos).
backups/
*.sql.gz
*.sql.zip
*.dump
*_backup.sql
*_dump.sql

# Datos internos de inventario (NUNCA commitear datos reales)
# Los ficheros reales van fuera del repo; los ejemplos anónimos viven en resources/sample/.
resources/*.csv
resources/*.xls
resources/*.xlsx
resources/*.vbs
resources/private/
exports/

# NiceGUI / Streamlit (eliminados — por si acaso)
.nicegui/
.streamlit/

# Archivos temporales
*.tmp
*.bak
~$*
